# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/nextpick
DB_USER=nextpick
DB_PASSWORD=replace_me

# Generate at least 32 random bytes and Base64-encode them.
JWT_SECRET=replace_with_base64_256_bit_secret
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# TMDB v4 Read Access Token (backend only)
TMDB_ACCESS_TOKEN=replace_with_tmdb_read_access_token
TMDB_LANGUAGE=es-ES
TMDB_REGION=ES

# AI provider (backend only). Keep disabled for catalog/auth testing.
# Google AI Studio: AI_PROVIDER=gemini, GEMINI_API_KEY=... and AI_MODEL=gemini-3.6-flash.
# OpenAI remains supported with AI_PROVIDER=openai and AI_API_KEY=...
AI_PROVIDER=disabled
AI_API_KEY=
GEMINI_API_KEY=
AI_MODEL=
AI_MAX_HISTORY_MESSAGES=12

# Runtime policy
CORS_ALLOWED_ORIGINS=http://localhost:4200
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=Strict
